# Auto-detect text files and normalize line endings to LF in the repository
* text=auto eol=lf

# Shell scripts and Maven Unix wrappers must use LF
*.sh text eol=lf
/mvnw text eol=lf

# Common text and source code files explicitly set to LF
*.java text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.js text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files that should never be line-ending normalized or modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.jar binary
*.war binary
*.ear binary
*.pdf binary
*.jks binary
*.keystore binary